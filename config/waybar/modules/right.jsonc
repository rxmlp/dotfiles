{
  "group/rmenu": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/powermenu",
      "custom/rivalcfg",
      "network",
      "bluetooth",
      "wireplumber",
    ],
  },
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
    },
    "modules": [
      "custom/hardware",
      "cpu",
      "memory",
      "custom/gpu",
      "custom/temperature_gpu",
    ],
  },

  "custom/powermenu": {
    "format": "󰍜",
    "on-click": "hyprctl dispatch 'hl.dsp.exec_cmd(\"[size 200 200; float; center; workspace w] kitty $HLS/kitty-tui/powermenu.sh\")'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.exec_cmd(\"[size 200 200; float; center; workspace w] kitty $HLS/kitty-tui/powermenu.sh\")'",
    // "menu": "on-click",
    // "menu-file": "~/.config/waybar/xml/power.xml",
    // "menu-actions": {
    //   "lock": "playerctl pause -a & loginctl lock-session",
    //   "suspend": "playerctl pause -a & loginctl lock-session && systemctl suspend",
    // },
  },

  "wireplumber": {
    "format": "{icon}  {volume}%",
    "on-scroll-up": "$HLS/volume/mako-volume.sh up",
    "on-scroll-down": "$HLS/volume/mako-volume.sh down",
    "tooltip": false,
    "format-muted": " Muted",
    "on-click": "$HLS/volume/mako-volume.sh mute",
    "on-click-right": "hyprctl dispatch 'hl.dsp.exec_cmd(\"[size 750 500; float; center; workspace w] kitty wiremix\")'",
    "format-icons": {
      "default": ["", "", ""],
    },
  },

  "bluetooth": {
    "format": " on",
    "format-connected": " {device_alias}",
    "format-off": "󰂲 off",
    "on-click": "$HLS/toggles/bluetooth.sh",
    "on-click-right": "hyprctl dispatch 'hl.dsp.exec_cmd(\"[size 750 500; float; center; workspace w] kitty bluetui\")'",
  },

  "network": {
      "interface": "wlan0",
      "format": "{ifname}",
      "format-wifi": "{essid} ({signalStrength}%) ",
      "format-ethernet": "{ipaddr}/{cidr} 󰊗",
      "format-disconnected": "", //An empty format will hide the module.
      "tooltip-format": "{ifname} via {gwaddr} 󰊗",
      "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
      "tooltip-format-ethernet": "{ifname} ",
      "tooltip-format-disconnected": "Disconnected",
      "on-click-right": "hyprctl dispatch 'hl.dsp.exec_cmd(\"[size 750 500; float; center; workspace w] kitty impala\")'",
      "max-length": 50
  },

  "custom/rivalcfg": {
    "exec": "while true; do rivalcfg --battery-level | grep -oP '\\d+'; sleep 10; done",
    "format": "󰍽 {text}",
  },

  "custom/hardware": {
    "format": "",
    "tooltip": false,
  },

  "cpu": {
    "interval": 10,
    "format": " {}%",
    "max-length": 10,
  },
  "memory": {
    "interval": 30,
    "format": " {used:0.1f}G/{total:0.1f}G",
  },
  "custom/gpu": {
    "format": "󰾲 {}%",
    "interval": 5,
    "return-type": "",
    "exec": "/opt/rocm/bin/rocm-smi --showuse --json --loglevel critical | jq -r '.card0.\"GPU use (%)\"'",
  },
  "custom/temperature_gpu": {
    "format": "{}°C",
    "interval": 5,
    "return-type": "",
    "exec": "/opt/rocm/bin/rocm-smi --showtemp --json --loglevel critical | jq -r '.card0.\"Temperature (Sensor edge) (C)\"'",
  },
}
